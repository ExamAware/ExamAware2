{$SITE_ADDRESS::80} {
	root * /srv/console
	encode gzip
	@api path /api/*
	handle @api {
		reverse_proxy control-server:3100
	}
	@device path /device/v1/connect*
	handle @device {
		reverse_proxy control-server:3100
	}
	handle {
		try_files {path} /index.html
		file_server
	}
	header /assets/* Cache-Control "public, max-age=31536000, immutable"
	header /index.html Cache-Control "no-cache"
}
