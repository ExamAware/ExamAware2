# Installer state. Existing installations must keep these values.
INSTALLER_STATE_VERSION='1'
INSTALL_MODE='docker'
DOMAIN=''
# PostgreSQL role name.
POSTGRES_USER=examaware
# PostgreSQL role password; generated by install.sh.
POSTGRES_PASSWORD=
# PostgreSQL database name.
POSTGRES_DB=examaware_control
# Native-mode database URL; generated by install.sh unless supplied.
DATABASE_URL=
# Public origin used by authentication and enrolled devices.
BETTER_AUTH_URL=
# Authentication signing secret; generated by install.sh.
BETTER_AUTH_SECRET=
# Device credential pepper; generated by install.sh.
DEVICE_CREDENTIAL_PEPPER=
# Initial administrator username.
CONTROL_ADMIN_USERNAME=admin
# Initial administrator display name.
CONTROL_ADMIN_NAME=School administrator
# Initial administrator password; generated by install.sh.
CONTROL_ADMIN_PASSWORD=
# Caddy site address, such as :80 or control.example.com.
SITE_ADDRESS=:80
# Host HTTP port for Docker mode.
HTTP_PORT=8219
# PostgreSQL image; domestic pull proxy is the default.
POSTGRES_IMAGE=docker.1ms.run/postgres:17-alpine
# Control image pull registry; releases are still pushed to ghcr.io.
CONTROL_REGISTRY=ghcr.1ms.run
# Image and release version.
CONTROL_VERSION=control-v0.1.2
# Server runtime environment.
NODE_ENV=production
