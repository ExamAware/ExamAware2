{
  "name": "@dsz-examaware/control-server",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "ExamAware school control server",
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=22.22.1"
  },
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "auth:schema:generate": "pnpm dlx @better-auth/cli@latest generate --config src/auth/auth.ts --output src/database/auth-schema.ts --yes",
    "auth:bootstrap-admin": "node dist/auth/bootstrap-admin.js"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.6.25",
    "@better-auth/sso": "^1.6.25",
    "@dsz-examaware/control-protocol": "workspace:*",
    "@dsz-examaware/core": "workspace:*",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-ws": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/websockets": "^11.1.28",
    "@thallesp/nestjs-better-auth": "^2.7.0",
    "better-auth": "^1.6.25",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.28",
    "@types/express": "^5.0.6",
    "@types/ws": "^8.18.1",
    "@types/node": "^25.0.3",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.10",
    "supertest": "^7.2.2",
    "typescript": "~5.9.3",
    "vitest": "^4.1.10"
  }
}
