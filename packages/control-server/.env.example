CONTROL_SERVER_PORT=3100
DATABASE_URL=postgres://examaware:examaware@127.0.0.1:5432/examaware_control
BETTER_AUTH_URL=http://localhost:3100
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_PASSWORD_ENABLED=true
AUTH_ALLOW_SELF_REGISTRATION=false
API_DOCS_ENABLED=true

# Used only by `pnpm control:bootstrap-admin` after the service is built and migrated.
# CONTROL_ADMIN_EMAIL=admin@example.edu
# CONTROL_ADMIN_NAME=School administrator
# CONTROL_ADMIN_PASSWORD=replace-with-a-strong-bootstrap-password
